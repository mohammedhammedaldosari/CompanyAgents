# انسخ هذا الملف إلى .env (لا ترفعه إلى أي مستودع). المبالغ بالهللة، والمنطقة الزمنية الرياض.

# ── الأساس (إلزامي) ──
DATABASE_URL=postgres://postgres@127.0.0.1:5432/agents
# مفتاح تشفير خزنة مفاتيح الموصلات: openssl rand -base64 32 — فقدانه يعني فقدان المفاتيح المخزنة
MASTER_KEY=
# كلمة مرور المالك عند أول تشغيل فقط (12 حرفًا فأكثر بأنواع مختلطة). بعدها استخدم: pnpm --filter @agents/server cli set-password
OWNER_PASSWORD=

# ── الخادم ──
PORT=8080
HOST=0.0.0.0
TZ=Asia/Riyadh
# true خلف HTTPS (إلزامي في الإنتاج)
COOKIE_SECURE=false
# true عند التشغيل خلف وكيل عكسي (Caddy/Nginx)
TRUST_PROXY=false
SESSION_DAYS=30
# مسار الواجهة المبنية (pnpm --filter @agents/web build)
WEB_DIST=../web/dist
LOG_LEVEL=info

# ── نماذج Claude ──
ANTHROPIC_API_KEY=
# الأسماء المعروضة سونيت/أوبس/هايكو ← معرّفات النماذج (تُحدَّث دون تعديل الشيفرة)
MODEL_SONNET=claude-sonnet-5
MODEL_OPUS=claude-opus-5
MODEL_HAIKU=claude-haiku-4-5
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=16000
AGENT_MAX_TURNS=12
MAX_CONCURRENT=3
USD_SAR=3.75

# ── مركز البائع (Amazon SP-API) — السوق السعودي ──
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
# أو الصقه من لوحة الإدارة ← الموصلات ← مركز البائع (يُشفّر في الخزنة)
SPAPI_REFRESH_TOKEN=
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
SPAPI_MARKETPLACE_ID=A17E79C6D8DWNP
SPAPI_SYNC_MINUTES=15
# رقم البائع (Merchant token) — مطلوب لتحديث الأسعار والقوائم بعد منح الموصل صلاحية الكتابة
SPAPI_SELLER_ID=
SPAPI_LANGUAGE=ar_AE

# ── إعلانات أمازون (Amazon Ads API) — منطقة أوروبا ──
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
# أو الصقه من لوحة الإدارة ← الموصلات ← إعلانات أمازون
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
ADS_ENDPOINT=https://advertising-api-eu.amazon.com

# ── التوسع والتفويض ──
# memory لنسخة واحدة، pg لتشغيل أكثر من نسخة خادم (LISTEN/NOTIFY)
EVENT_BUS=memory
# الرابط العام للمنصة؛ يُستخدم عنوانًا للعودة في تفويض OAuth، مثل https://agents.example.com
PUBLIC_URL=
