{
  "name": "@agents/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "خادم شركة الوكلاء: الواجهة البرمجية، البث الحي، المحرك، ومشغّل الوكلاء",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agents/domain": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "express": "^5.2.1",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist"
  ]
}
