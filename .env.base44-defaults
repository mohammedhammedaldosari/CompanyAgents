# Base44 development defaults — app boots without external credentials.
# Real secrets in /run/base44/app.env (platform-managed) override these.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
COOKIE_SECURE=false
LOG_LEVEL=info
EVENT_BUS=memory
SESSION_DAYS=30
USD_SAR=3.75
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=16000
AGENT_MAX_TURNS=12
MAX_CONCURRENT=3

# Placeholder encryption key (overridden by /run/base44/app.env)
MASTER_KEY=base44-dev-placeholder-key-not-for-production-use-32c
# Placeholder owner password for first-boot login (overridden by /run/base44/app.env)
OWNER_PASSWORD=DevOwner2024!
